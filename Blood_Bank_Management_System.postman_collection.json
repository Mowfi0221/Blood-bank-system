{
  "info": {
    "_postman_id": "a9184f47-83c9-4673-8a39-blood-bank-api-v1",
    "name": "Blood Bank Management System APIs",
    "description": "Comprehensive Postman Collection for testing Blood Bank Management System REST APIs with Spring Boot, JWT, and MongoDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "donorToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Public APIs",
      "item": [
        {
          "name": "Public Search Donors (All Available)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/donors/search",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "search"]
            }
          }
        },
        {
          "name": "Public Search Donors (Filter by Blood Group & City)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/donors/search?bloodGroup=O%2B&city=Chennai",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "search"],
              "query": [
                { "key": "bloodGroup", "value": "O+" },
                { "key": "city", "value": "Chennai" }
              ]
            }
          }
        },
        {
          "name": "Donor Registration",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Suresh Krishnan\",\n  \"age\": 26,\n  \"bloodGroup\": \"O+\",\n  \"city\": \"Chennai\",\n  \"phone\": \"9876500001\",\n  \"email\": \"suresh.k@example.com\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/donors/register",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication APIs",
      "item": [
        {
          "name": "Donor Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('donorToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9876543210\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/donor/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "donor", "login"]
            }
          }
        },
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "    pm.collectionVariables.set('adminToken', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "admin", "login"]
            }
          }
        },
        {
          "name": "Forgot Password (Request OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"9876543210\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "verify-otp"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"9876543210\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"newPassword123\",\n  \"confirmPassword\": \"newPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            }
          }
        }
      ]
    },
    {
      "name": "Donor Profile APIs (Protected)",
      "item": [
        {
          "name": "Get Logged-in Donor Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{donorToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/donors/me",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "me"]
            }
          }
        },
        {
          "name": "Update Donor Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{donorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"age\": 29,\n  \"bloodGroup\": \"O+\",\n  \"city\": \"Chennai Central\",\n  \"email\": \"rahul.sharma@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/donors/me",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "me"]
            }
          }
        },
        {
          "name": "Update Availability (Toggle YES / NO)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{donorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"availability\": \"NO\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/donors/me/availability",
              "host": ["{{baseUrl}}"],
              "path": ["donors", "me", "availability"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin APIs (Protected)",
      "item": [
        {
          "name": "Get All Registered Donors",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/donors",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "donors"]
            }
          }
        },
        {
          "name": "Get Total Donors Count",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/donors/count",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "donors", "count"]
            }
          }
        },
        {
          "name": "Get Blood Bank Statistics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/donors/statistics",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "donors", "statistics"]
            }
          }
        },
        {
          "name": "Delete Donor by ID",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/donors/:id",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "donors", ":id"],
              "variable": [{ "key": "id", "value": "DONOR_ID_HERE" }]
            }
          }
        }
      ]
    }
  ]
}
